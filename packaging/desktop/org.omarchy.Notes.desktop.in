[Desktop Entry]
Type=Application
Name=Omarchy Notes
GenericName=Notes
Comment=Rich notes with checklists, tables and attachments
Exec=@ONOTES_BIN@
Icon=@ONOTES_APP_ID@
Terminal=false
Categories=Office;
Keywords=notes;notebook;checklist;todo;omarchy;
StartupNotify=true
StartupWMClass=@ONOTES_APP_ID@
Actions=new-note;quick-note;

[Desktop Action new-note]
Name=New Note
Exec=@ONOTES_BIN@ --new

[Desktop Action quick-note]
Name=Quick Note
Exec=@ONOTES_BIN@ --quick-note
