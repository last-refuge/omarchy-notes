# Maintainer: Jason Alexander <jason@greatspark.com>
# Generated with packaging/prepare-release.py; submit the generated copy to AUR.
pkgname=omarchy-notes
pkgver=1.0.0
pkgrel=1
pkgdesc='Fast, native notes for Omarchy, inspired by Apple Notes'
arch=('x86_64' 'aarch64')
url='https://lastrefuge.ai/projects/omarchy-notes'
license=('MIT')
depends=('glibc' 'hicolor-icon-theme' 'libgcc' 'libstdc++' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'sqlite')
makedepends=('cmake' 'ninja' 'pkgconf')
optdepends=('qt6-wayland: native Wayland support'
            'qt6-imageformats: WebP, TIFF and other image formats in notes'
            'xdg-utils: open attachments in their default applications')
source=("https://github.com/jasona/omarchy-notes/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
b2sums=('@SOURCE_B2SUM@')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DBUILD_TESTING=OFF \
    -Wno-dev
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen "$srcdir/build/src/app/omarchy-notes" --version
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
